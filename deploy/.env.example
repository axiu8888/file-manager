# 复制为 /opt/apps/kiftd/.env 后按需修改
# 默认口令仅为示例，生产务必修改

# 宿主机部署根目录（install.sh 默认写入此处）
KIFTD_HOST_ROOT=/opt/apps/kiftd

# 对外 HTTP 端口（nginx）
HTTP_PORT=80

# PostgreSQL（容器服务名 postgres，与 SPRING_DATASOURCE_* 一致）
POSTGRES_DB=kiftd
POSTGRES_USER=kiftd
POSTGRES_PASSWORD=kiftd

# Spring / kiftd
SERVER_PORT=8080
KIFTD_JWT_SECRET=change-me
KIFTD_JWT_EXPIRE_HOURS=72
# 同域经 nginx 访问时保持为空；跨域示例：http://example.com
KIFTD_CORS_ALLOWED_ORIGINS=
KIFTD_ADMIN_USERNAME=admin
KIFTD_ADMIN_PASSWORD=change-me
KIFTD_SIGNUP_ENABLED=true
JAVA_OPTS=-Xms256m -Xmx1024m
