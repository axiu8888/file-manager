# kiftd 前端静态资源 + 反向代理
FROM nginx:alpine

LABEL org.opencontainers.image.title="kiftd-nginx" \
      org.opencontainers.image.description="kiftd static frontend and reverse proxy"

RUN rm -f /etc/nginx/conf.d/default.conf

COPY nginx.conf /etc/nginx/conf.d/kiftd.conf
COPY dist/front/ /usr/share/nginx/html/

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
